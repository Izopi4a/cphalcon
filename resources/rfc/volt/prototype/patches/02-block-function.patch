diff -ru a/ext/phalcon/mvc/view/engine/volt/base.c b/ext/phalcon/mvc/view/engine/volt/base.c
--- a/ext/phalcon/mvc/view/engine/volt/base.c	2026-10-16 16:56:24.982913946 +0300
+++ b/ext/phalcon/mvc/view/engine/volt/base.c	2026-10-16 16:56:25.168443009 +0300
@@ -653,6 +653,18 @@
 
 			case PHVOLT_T_BLOCK:
 				/*
+				 * "block" opens a {% block %} statement only right after the
+				 * opening delimiter; anywhere else ({{ block("title") }},
+				 * article.block) it is a plain identifier, like "default"
+				 */
+				if (prev_token != PHVOLT_T_OPEN_DELIMITER) {
+					phvolt_parse_with_token(phvolt_parser, PHVOLT_T_IDENTIFIER, PHVOLT_IDENTIFIER, &token, parser_status);
+					break;
+				}
+
+				efree(token.value);
+
+				/*
 				 * Blocks may nest, and may sit inside if/for/switch: the
 				 * compiler resolves inheritance on the AST
 				 */
diff -ru a/ext/phalcon/mvc/view/engine/volt/scanner.re b/ext/phalcon/mvc/view/engine/volt/scanner.re
--- a/ext/phalcon/mvc/view/engine/volt/scanner.re	2026-10-16 16:56:24.980914937 +0300
+++ b/ext/phalcon/mvc/view/engine/volt/scanner.re	2026-10-16 16:56:25.168350252 +0300
@@ -384,6 +384,8 @@
 		'block' {
 			s->statement_position++;
 			token->opcode = PHVOLT_T_BLOCK;
+			token->value = estrndup(start, YYCURSOR - start);
+			token->len = YYCURSOR - start;
 			return 0;
 		}
 
